{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ReportCards": {
    "BulkMaxStudents": 100,
    "BulkMaxConcurrent": 2
  },
  "Jwt": {
    "Issuer": "smss-api",
    "Audience": "smss-web",
    "Key": "",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 1,
    "RememberMeRefreshTokenDays": 14
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "LoginThrottle": {
    "MaxFailedPerLoginId": 5,
    "MaxFailedPerIp": 30,
    "WindowMinutes": 15,
    "MaxTrackedKeys": 50000
  },
  "RateLimiting": {
    "DriverLocation": {
      "PermitLimit": 12,
      "WindowSeconds": 60
    },
    "PublicEnquiries": {
      "PermitLimit": 5,
      "WindowMinutes": 10
    },
    "PublicPartnerSchools": {
      "PermitLimit": 60,
      "WindowMinutes": 1
    }
  },
  "PartnerSchools": {
    "MaxItems": 60,
    "CacheSeconds": 300
  },
  "TransportLive": {
    "RejectMockLocations": true,
    "MinIntervalSeconds": 20,
    "IntervalSeconds": 60,
    "LiveSeconds": 180,
    "StaleSeconds": 600,
    "HideOfflineAfterMinutes": 60,
    "MaxSessionHours": 16,
    "ResumeWithinSeconds": 600,
    "MaxAccuracyMeters": 200,
    "MaxFixAgeSeconds": 600,
    "MaxFutureSeconds": 120
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "FileStorage": {
    "RootPath": "uploads"
  },
  "Bootstrap": {
    "Enabled": false,
    "SuperAdminSetupKey": ""
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "smsserp.info@gmail.com",
    "SenderName": "SMSS",
    "SenderAppPassword": "",
    "LoginUrl": "http://localhost:4200/login"
  },
  "Firebase": {
    "DryRun": true
  },
  "WhatsApp": {
    "Enabled": false,
    "Sender": "Log",
    "AccessToken": "",
    "PhoneNumberId": "",
    "BusinessAccountId": "",
    "ApiVersion": "v21.0",
    "BaseUrl": "https://graph.facebook.com",
    "AppSecret": "",
    "WebhookVerifyToken": "",
    "Language": "en",
    "TimeoutSeconds": 15,
    "TemplateParentAccountReady": "parent_account_ready",
    "TemplateParentChildAdded": "parent_child_added",
    "TemplateParentLoginCode": "parent_login_code",
    "TemplateParentStudentLoginReady": "parent_student_login_ready"
  },
  "ParentAccounts": {
    "SetPasswordLinkHours": 72,
    "ResetLinkMinutes": 60,
    "ResendLimitPer24Hours": 3,
    "WebBaseUrl": ""
  },
  "AllowedHosts": "*"
}
