# Copy to .env (untracked) and fill in. Never commit the real URL.
# Development: the HTTPS URL of your cloudflared/ngrok tunnel to the local API, no trailing slash.
# EAS builds: set the same variable in the EAS environment instead of a file.
EXPO_PUBLIC_API_BASE_URL=https://your-tunnel.example.trycloudflare.com
# Development builds only: send a location fix every N seconds instead of the server's 60 (quick emulator passes). Ignored in release builds.
# EXPO_PUBLIC_DUTY_INTERVAL_SECONDS=15
# Development builds only, EMULATOR ONLY: the emulator has no network location, so Balanced gives no fixes there; ask for GPS-grade fixes instead.
# EXPO_PUBLIC_DUTY_ACCURACY=high
# Windows only: pin the CMake version so the first Android build does not fail on 260-character paths (see CLAUDE.md, plugins/withAndroidCmakeVersion.js).
# SMSS_ANDROID_CMAKE_VERSION=4.1.2
