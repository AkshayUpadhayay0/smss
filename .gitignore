
# Private employee documents (never commit; never served by URL)
uploads-private/

# Generated demo-school credentials (plaintext passwords; never commit)
# Docs/demo-credentials.txt

# Uploaded files: school logos and student photos (real people; never commit)
smss-api/smss-api/uploads/
smss-api/smss-api/uploads-private/
**/uploads-private/

# Demo seeding: state files hold generated passwords; credential text files; local database dumps
scripts/demo-seed/state_*.json
scripts/demo-seed/__pycache__/
Docs/demo-credentials.txt
**/*credentials*.txt
Docs/smss-db_*.sql
*.dump

# Database dumps and backups: they hold real personal data and password hashes (never commit). Migration scripts Docs/smss-<feature>.sql stay tracked.
Docs/smss-db*.sql
*.dump
*.bak
*backup*

# Visual Studio per-user state (never commit)
.vs/
**/.vs/
*.csproj.user

# Environment files and extra dump/backup extensions (never commit)
.env
.env.*
**/.env
**/.env.*
!.env.example
*.pgdump
*.dmp
*.backup
